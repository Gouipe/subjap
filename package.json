{
  "name": "subjap",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension for learning Japanese through anime streaming",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/verify-netflix-bridge.mjs",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "vite --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.0.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "dexie": "^4.0.7",
    "kuromoji": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
